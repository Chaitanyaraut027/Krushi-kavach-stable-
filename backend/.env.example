# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/krishikavach

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_groq_api_key_here

# ── ML Server (FastAPI — crop disease detection) ──────────────
# Development: run `python app.py` inside crop_project/ (runs on port 8000)
# Production:  set this to your Render deployment URL after deploying crop_project/
ML_SERVER_URL=http://localhost:8000
# ML_SERVER_URL=https://krishi-kavach-ml.onrender.com

# ── Admin Credentials (auto-created on first run) ─────────────
ADMIN_EMAIL=admin@krishikavach.com
ADMIN_PASSWORD=Admin@1234

# ── WhatsApp (optional) ───────────────────────────────────────
WHATSAPP_API_KEY=your_whatsapp_key_here

# ── Redis Cache (high-performance caching for LLM & market queries) ──
# Local: redis://localhost:6379
# Production: rediss://default:<password>@<host>:<port> (e.g. Upstash or Redis Cloud)
# Note: If offline or omitted, backend automatically falls back to direct queries without crashing
REDIS_URL=redis://localhost:6379
